        { "key": "thicknessIn", "label": "Overlay thickness", "unit": "in", "default": 2 },
        { "key": "densityLbCf", "label": "Asphalt density", "unit": "lb/cf", "default": 145, "advanced": true },
        { "key": "materialFactor", "label": "Asphalt material factor", "unit": "x", "default": 1.05, "advanced": true }
      ],
      "components": [
        { "id": "planing", "label": "Removal of asphalt mat (planing)", "item": "co_cdot_202-00240", "quantity": { "kind": "area", "length": "lengthMiles", "width": "widthFt", "unit": "SY" } },
        { "id": "asphalt", "label": "Hot mix asphalt (Grading S) (100) (PG 64-22)", "item": "co_cdot_403-33841", "quantity": { "kind": "asphalt_tons", "length": "lengthMiles", "width": "widthFt", "thickness": "thicknessIn", "density": "densityLbCf", "materialFactor": "materialFactor", "unit": "TON" } }
