        { "id": "asphalt", "label": "Hot mix asphalt (Grading S) (100) (PG 64-22)", "item": "co_cdot_403-33841", "quantity": { "kind": "asphalt_tons", "length": "lengthMiles", "width": "widthFt", "thickness": "asphaltThicknessIn", "density": "densityLbCf", "materialFactor": "materialFactor", "unit": "TON" }, "when": { "input": "newSurface", "equals": "asphalt" } },
