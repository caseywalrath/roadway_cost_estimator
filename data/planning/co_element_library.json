{
  "schemaVersion": 1,
  "state": "CO",
  "label": "Colorado municipal corridor planning library",
  "priceTable": "public/data/states/co/planning_prices.json",
  "notes": "Hand-edited. Item components price from the generated price table (2026 planning basis). Component unitCost values are direct 2026 assembly costs from docs/planning-v2-calibration.md section 4. Factors and stage values from sections 1.1 and 1.3 of the same report.",
  "projectInputs": [
    { "key": "lengthMiles", "label": "Corridor length", "unit": "mi", "default": 0.5, "min": 0 },
    { "key": "roadwayWidthFt", "label": "Roadway width (curb to curb)", "unit": "ft", "default": 40, "min": 0 },
    { "key": "intersections", "label": "Intersections", "unit": "count", "default": 4, "min": 0, "integer": true }
  ],
  "stages": [
    { "id": "concept", "label": "Concept", "contingency": 0.30, "rangeLow": -0.25, "rangeHigh": 0.50 },
    { "id": "planning_study", "label": "Planning study", "contingency": 0.25, "rangeLow": -0.20, "rangeHigh": 0.30 }
  ],
  "defaultStage": "concept",
  "engineering": { "design": 0.10, "constructionEngineering": 0.10 },
  "factors": {
    "mill_overlay": { "minor": 0.56, "trafficControl": 0.08, "mobilization": 0.07, "basis": "CDOT urban complete contracts 2023-03-26 onward, n = 8" },
    "reconstruction": { "minor": 0.55, "trafficControl": 0.12, "mobilization": 0.10, "basis": "CDOT statewide complete contracts, n = 29; minor is a judgment value between statewide (0.42) and urban/FHU evidence (0.76-1.26)" },
    "path": { "minor": 0.35, "trafficControl": 0.05, "mobilization": 0.10, "basis": "Judgment; no CDOT path contracts in the data" },
    "elements_only": { "minor": 0.46, "trafficControl": 0.16, "mobilization": 0.11, "basis": "CDOT urban complete contracts 2023-03-26 onward, n = 22" }
  },
  "groups": [
    { "id": "base", "label": "Base treatment", "selection": "one" },
    { "id": "corridor", "label": "Corridor elements", "selection": "any" },
    { "id": "spot", "label": "Spot elements", "selection": "any" },
    { "id": "other", "label": "Other costs", "selection": "amount" }
  ],
  "elements": [
